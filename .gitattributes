# Files that belong in the repository but not in the distributed package.
# `git archive` honours these, so the release zip is built straight from a tag.
/.gitattributes    export-ignore
/.gitignore        export-ignore

# Developer tooling and tests that need the repository (a Magento install, a running store)
/dev               export-ignore
/phpunit.xml.dist  export-ignore
/Test              export-ignore
