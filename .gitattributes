# Files that belong in the repository but not in the distributed package.
# `git archive` honours these, so the release zip is built straight from a tag.
/.gitattributes    export-ignore
/.gitignore        export-ignore

# Developer tooling (the unit suite's bootstrap and configuration)
/dev               export-ignore
/phpunit.xml.dist  export-ignore

# GraphQL API tests: they need a running store with the fixtures
/Test/Api          export-ignore
