<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- addProductsToCart: bundle item custom options sent as entered_options with an xab-custom uid -->
    <type name="Magento\Quote\Model\Cart\BuyRequest\BuyRequestBuilder">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="xab_bundle_custom_option" xsi:type="object">Xumulus\AdvanceBundlesGraphQl\Model\Cart\BuyRequest\CustomOptionDataProvider</item>
            </argument>
        </arguments>
    </type>
    <!-- Runs after the main module's buy request plugins (sortOrder 10 and 20) -->
    <type name="Magento\Bundle\Model\Product\Type">
        <plugin name="xumulus_advancebundlesgraphql_reject_unknown_custom_options" type="Xumulus\AdvanceBundlesGraphQl\Plugin\RejectUnknownCustomOptions" sortOrder="30"/>
    </type>
    <!-- addWishlistItemsToCart: the texts saved on a wishlist bundle become xab-custom entered_options -->
    <type name="Magento\WishlistGraphQl\Model\CartItems\CartItemsRequestBuilder">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="xab_bundle_custom_option" xsi:type="object">Xumulus\AdvanceBundlesGraphQl\Model\Wishlist\CartItems\CustomOptionDataProvider</item>
            </argument>
        </arguments>
        <plugin name="xumulus_advancebundlesgraphql_normalize_legacy_wishlist_buy_request" type="Xumulus\AdvanceBundlesGraphQl\Plugin\Wishlist\NormalizeLegacyBuyRequest"/>
    </type>
</config>
