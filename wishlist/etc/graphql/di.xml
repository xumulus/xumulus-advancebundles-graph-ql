<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- addWishlistItemsToCart: the texts saved on a wishlist bundle become xab-custom entered_options -->
    <type name="Magento\WishlistGraphQl\Model\CartItems\CartItemsRequestBuilder">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="xab_bundle_custom_option" xsi:type="object">Xumulus\AdvanceBundlesGraphQlWishlist\Model\CartItems\CustomOptionDataProvider</item>
            </argument>
        </arguments>
        <plugin name="xumulus_advancebundlesgraphql_normalize_legacy_wishlist_buy_request" type="Xumulus\AdvanceBundlesGraphQlWishlist\Plugin\NormalizeLegacyBuyRequest"/>
    </type>
</config>
